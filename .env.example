# OPENAI_COMPAT_API_KEY: Free OpenAI-compatible open-weight provider API key
# (e.g., OpenRouter free :free tier for Qwen / DeepSeek / Llama, Groq free tier, Hugging Face Router, or Cerebras).
# Enter your free key securely in the Secrets panel in AI Studio.
# Not required if using Local Ollama (http://10.0.2.2:11434/v1) or Offline KSMKE Guide.
OPENAI_COMPAT_API_KEY=MY_FREE_OPEN_AI_API_KEY
